{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ME",
  "version": "2.2.3",
  "identifier": "com.swyiic.mobilee",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ME",
        "width": 1000,
        "height": 1020,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "rules/*.json"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
